<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema oscuro por defecto -->
    <style name="Theme.Calculadora" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcNumber" parent="CalcButton">
        <item name="android:background">@drawable/btn_number</item>
    </style>

    <style name="CalcFunction" parent="CalcButton">
        <item name="android:background">@drawable/btn_function</item>
    </style>

    <style name="CalcOperator" parent="CalcButton">
        <item name="android:background">@drawable/btn_operator</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="CalcEquals" parent="CalcButton">
        <item name="android:background">@drawable/btn_equals</item>
        <item name="android:textSize">32sp</item>
    </style>
</resources>
